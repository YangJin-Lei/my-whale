<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mywhale_secure_prefs.xml" />
        <exclude domain="database" path="mywhale_cache.db" />
        <exclude domain="database" path="mywhale_cache.db-journal" />
        <exclude domain="file" path="updates" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mywhale_secure_prefs.xml" />
        <exclude domain="database" path="mywhale_cache.db" />
        <exclude domain="database" path="mywhale_cache.db-journal" />
        <exclude domain="file" path="updates" />
    </device-transfer>
</data-extraction-rules>
